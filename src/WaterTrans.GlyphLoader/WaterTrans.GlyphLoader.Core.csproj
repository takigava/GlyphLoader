<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Version>2.0</Version>
    <Authors>WaterTrans and Contributors</Authors>
    <Product>GlyphLoader</Product>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>GlyphLoader is a .NET Core library for TrueType, OpenType font.
It is written in C#, designed to be small, efficient and portable while capable of producing high-quality glyph images.
In WebAssembly environment, it can be used for application development using glyph outline information.
</Description>
    <Copyright>© 2025 WaterTrans and Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/takigava/GlyphLoader</PackageProjectUrl>
    <PackageTags>OpenType TrueType WOFF2 TypeLoader WebAssembly Glyph GlyphTypeface Font Outline</PackageTags>
    <PackageReleaseNotes>https://github.com/takigava/GlyphLoader</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/takigava/GlyphLoader</RepositoryUrl>
    <Company></Company>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>bin\WaterTrans.GlyphLoader.xml</DocumentationFile>
    <CodeAnalysisRuleSet />
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>bin\WaterTrans.GlyphLoader.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.4" />
  </ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WaterTrans.GlyphLoader.Core.Tests"/>
	</ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\stylecop.json" Link="stylecop.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </AdditionalFiles>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

</Project>
